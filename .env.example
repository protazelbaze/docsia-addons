# ============ Paperless (API) ============
# Appel interne sur le réseau Docker de Paperless ; ALLOWED_HOSTS impose l'en-tête Host.
PAPERLESS_URL=http://paperless_app:8000
PAPERLESS_HOST_HEADER=docs.montaigne.contact
PAPERLESS_TOKEN=CHANGE_ME
HTTP_TIMEOUT=60

# ============ PostgreSQL Paperless (tables recolte.*) ============
PGHOST=paperless_postgres
PGPORT=5432
PGDATABASE=paperless
PGUSER=paperless
PGPASSWORD=CHANGE_ME
PG_SCHEMA=recolte

# ============ PostgreSQL DOCSIA (phase ingestion IA) ============
DOCSIA_PGHOST=docsia_postgres
DOCSIA_PGPORT=5432
DOCSIA_PGDATABASE=docsia
DOCSIA_PGUSER=docsia
DOCSIA_PGPASSWORD=CHANGE_ME

# ============ Cache local (monté en volume) ============
CACHE_DIR=/app/cache
